<%- include('partials/header') %>

<main class="content-page">
  <section class="page-heading">
    <p class="eyebrow">Find your place to help</p>
    <h1><%= title %></h1>

    <h2>Service Project Categories</h2>
    <p>Choose an area that matches the impact you want to make in your community.</p>
  </section>

  <% if (categories && categories.length > 0) { %>
    <ul class="card-grid category-grid">
      <% categories.forEach((category) => { %>
        <li class="info-card category-card">
          <p class="category-label">Service category</p>
          <h2><%= category.name %></h2>
          <p>Discover meaningful service opportunities that support your community.</p>
        </li>
      <% }); %>
    </ul>
  <% } else { %>
    <p class="empty-message">There are no service categories available right now. Please check again soon.</p>
  <% } %>
</main>

<%- include('partials/footer') %>
