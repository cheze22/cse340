<%- include('partials/header') %>

<main class="content-page">
  <section class="page-heading">
    <p class="eyebrow">Ways to contribute</p>
    <h1><%= title %></h1>

    <h2>Find a project that matters to you</h2>

    <p>Explore opportunities that bring practical support, skills, and care to communities.</p>
  </section>

  <section class="card-grid project-grid" aria-label="Service project opportunities">
    <article class="info-card">
      <span class="card-number">01</span>
      <h2>Community Care</h2>
      <p>Help neighbors through local outreach, food drives, and community support efforts.</p>
    </article>
    <article class="info-card">
      <span class="card-number">02</span>
      <h2>Learning Support</h2>
      <p>Share your knowledge by helping learners build confidence and reach their goals.</p>
    </article>
    <article class="info-card">
      <span class="card-number">03</span>
      <h2>Healthy Spaces</h2>
      <p>Join hands-on projects that care for public spaces and promote well-being.</p>
    </article>
  </section>
</main>

<%- include('partials/footer') %>
