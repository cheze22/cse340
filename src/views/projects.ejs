<%- include('partials/header') %>

<main class="content-page">
  <section class="page-heading">
    <p class="eyebrow">Ways to contribute</p>
    <h1><%= title %></h1>

    <h2>Find a project that matters to you</h2>

    <p>Explore opportunities that bring practical support, skills, and care to communities.</p>
  </section>

  <% if (projects && projects.length > 0) { %>
    <section class="card-grid project-grid" aria-label="Service project opportunities">
      <% projects.forEach((project) => { %>
        <article class="info-card project-card">
          <p class="project-date"><%= project.project_date %></p>
          <h2><%= project.title %></h2>
          <p class="project-organization"><%= project.organization_name %></p>
          <p><%= project.description %></p>
          <p class="project-location"><span>Location:</span> <%= project.location %></p>
        </article>
      <% }); %>
    </section>
  <% } else { %>
    <p class="empty-message">There are no service projects available right now. Please check again soon.</p>
  <% } %>
</main>

<%- include('partials/footer') %>
